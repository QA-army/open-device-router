{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/QA-army/opendevicerouter/schema/provider.schema.json",
  "title": "OpenDeviceRouter provider entry",
  "description": "One file per provider in registry/providers/. Every changeable fact carries a first-party source URL and the entry carries the date it was last checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "checked_at",
    "homepage",
    "surfaces",
    "hands",
    "signup",
    "credentials",
    "allowances",
    "policy",
    "sources"
  ],
  "definitions": {
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tri": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "surface": {
      "enum": [
        "ios-simulator",
        "android-emulator",
        "ios-real",
        "android-real",
        "desktop-browser",
        "mobile-browser"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "description": "launch = one of the first four routed targets. baseline = always available, no account. researched = signup and free tier checked. candidate = pricing checked only.",
      "enum": [
        "launch",
        "baseline",
        "researched",
        "candidate"
      ]
    },
    "checked_at": {
      "$ref": "#/definitions/date"
    },
    "homepage": {
      "$ref": "#/definitions/url"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/surface"
      }
    },
    "hands": {
      "description": "How clicks, swipes and snapshots reach the device. OpenDeviceRouter does not implement device control itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent-device",
            "cdp-passthrough",
            "webdriver-passthrough",
            "playwright-connect",
            "unknown"
          ]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/surface"
          },
          "description": "Surfaces this control path covers. Omit when it covers every surface the provider lists."
        },
        "provider_id": {
          "description": "Argument for `agent-device connect <provider_id>`. Omit for local devices.",
          "type": "string"
        },
        "plugin": {
          "description": "agent-device plugin package, if the provider ships as one.",
          "type": "string"
        },
        "env": {
          "description": "Environment variables the control tool reads. `odr connect --done` checks that they are set and never reads or stores their values.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "connect_args": {
          "description": "Extra arguments `agent-device connect` needs for this provider, with placeholders.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/definitions/url"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "url": {
          "$ref": "#/definitions/url"
        },
        "evidence": {
          "description": "live_page = form opened in a browser, nothing submitted. docs = first-party documentation. not_researched = signup not checked yet.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "live_page",
              "docs",
              "not_researched",
              "not_applicable"
            ]
          }
        },
        "sso": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "google",
              "github",
              "microsoft",
              "apple",
              "agentid",
              "email_code",
              "saml_oidc"
            ]
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "from"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "required": {
                "$ref": "#/definitions/tri"
              },
              "from": {
                "description": "Who can supply the value. user = only the person. agent = a coding agent can derive it from the repo or git config.",
                "enum": [
                  "user",
                  "agent",
                  "user_or_sso"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "human_steps": {
          "description": "Steps the person must do themselves. OpenDeviceRouter never automates these.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "accept_terms",
              "captcha_possible",
              "email_verification",
              "phone_code",
              "payment_card",
              "sales_review"
            ]
          }
        },
        "card_required": {
          "$ref": "#/definitions/tri"
        },
        "phone_required": {
          "$ref": "#/definitions/tri"
        },
        "work_email_required": {
          "$ref": "#/definitions/tri"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "acquire"
      ],
      "properties": {
        "kind": {
          "enum": [
            "api_key",
            "key_secret",
            "username_access_key",
            "iam_role",
            "cloud_account",
            "none",
            "unknown"
          ]
        },
        "acquire": {
          "description": "device_code / browser_login need no copy-paste. manual_copy means the person copies a key from a dashboard.",
          "enum": [
            "device_code",
            "browser_login",
            "iam_role",
            "manual_copy",
            "none",
            "unknown"
          ]
        },
        "login_command": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "source": {
          "$ref": "#/definitions/url"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "unit",
          "source"
        ],
        "properties": {
          "type": {
            "description": "How the free allowance renews. unverified = the vendor page does not say.",
            "enum": [
              "self_hosted",
              "public_repo",
              "daily",
              "monthly",
              "oss_program",
              "one_time",
              "unverified"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "device_minute",
              "browser_minute",
              "minute",
              "credit",
              "usd",
              "test_run",
              "unlimited"
            ]
          },
          "per_minute": {
            "description": "Units consumed per session minute, by surface. Needed for the router to meter units that are not minutes. Without it, credit and usd allowances are never routed.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "ios-simulator": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "android-emulator": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ios-real": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "android-real": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "desktop-browser": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mobile-browser": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "scope": {
            "type": "string"
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/surface"
            },
            "description": "Surfaces this allowance pays for. Omit when it covers every surface the provider lists."
          },
          "manual_only": {
            "description": "True when the allowance only covers interactive manual testing. Never routed.",
            "type": "boolean"
          },
          "max_session_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_parallel": {
            "type": "integer",
            "minimum": 1
          },
          "expires_days": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "$ref": "#/definitions/url"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "paid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "source"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/url"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_accounts_per_org",
        "benchmark_publication"
      ],
      "properties": {
        "max_accounts_per_org": {
          "const": 1
        },
        "benchmark_publication": {
          "description": "allowed_with_replication = terms permit it if replication details are published. no_clause_found = terms were read and no clause was found (not a clearance). restricted = terms prohibit publishing performance information. unknown = terms not checked for this.",
          "enum": [
            "allowed_with_replication",
            "no_clause_found",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        },
        "third_party_access": {
          "enum": [
            "restricted",
            "no_clause_found",
            "unknown",
            "not_applicable"
          ]
        },
        "terms_url": {
          "$ref": "#/definitions/url"
        },
        "terms_checked_note": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/url"
      }
    }
  }
}
